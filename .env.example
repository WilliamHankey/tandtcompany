# Sanity (create project at https://www.sanity.io/manage)
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-05-22

# Sanity Studio (same project — used in /sanity folder)
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_HOSTNAME=tandtcompany

# Seed script (write token from sanity.io/manage → API → Tokens)
SANITY_API_TOKEN=your_write_token

# Yoco (https://business.yoco.com → Checkout API → Integration settings)
VITE_YOCO_PUBLIC_KEY=pk_test_xxxxxxxx
YOCO_SECRET_KEY=«redacted:sk_test_…»
# Webhook secret: register once via POST /api/yoco/register-webhook, then
# copy the returned `secret` (shown only once) here.
YOCO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx=

# Google Analytics 4 (https://analytics.google.com)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=orders@tandtcompany.com